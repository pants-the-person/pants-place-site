{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pants-place-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "pants.place/*",
      "zone_name": "pants.place"
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
