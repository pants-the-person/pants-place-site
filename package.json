{
  "name": "pants-place-98",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pants Place 98 — a functional Windows 98 desktop, FreeDOS VM, Winamp and fake internet.",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node scripts/wine/ensure.mjs && astro dev",
    "start": "astro dev",
    "build": "node scripts/wine/ensure.mjs && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "wine:prepare": "node scripts/wine/prepare.mjs",
    "wine:runtime": "node -e \"import('./scripts/wine/sync-runtime.mjs').then(m=>m.syncRuntime())\"",
    "wine:assets": "node scripts/wine/sync-assets.mjs",
    "wine:registry": "node scripts/wine/gen-registry.mjs",
    "wine:verify": "node scripts/wine/verify.mjs",
    "wine:smoke": "node scripts/smoke-wine.mjs",
    "sync:webring": "node scripts/fetch-oldnet-webring.mjs",
    "generate:media": "node scripts/generate-media.mjs",
    "generate:og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/vt323": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "@zenfs/core": "^2.9.0",
    "@zenfs/dom": "^1.2.14",
    "98.css": "^0.1.21",
    "astro": "^7.4.5",
    "libmount": "^0.6.0",
    "preact": "^11.1.1",
    "spessasynth_lib": "^4.4.3",
    "v86": "^0.5.473"
  },
  "devDependencies": {
    "midi-writer-js": "^3.2.1",
    "playwright": "^1.64.1",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true,
    "midi-writer-js@3.2.1": true
  }
}
