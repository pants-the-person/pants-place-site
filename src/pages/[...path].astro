---
import DesktopPage from '../components/os/DesktopPage.astro';
import { getDesktopDocuments } from '../lib/desktop';
import { personalSites, type PersonalSite } from '../kernel/sites';
import type { PersonalSiteDeepLink } from '../kernel/autostart';

/** Public desktop deep links. Nested paths are proxied to this page by _redirects. */
export function getStaticPaths() {
  return personalSites.map((site) => ({
    params: { path: site.launcherPath.replace(/^\/+/, '') },
    props: {
      site,
      deepLink: {
        siteId: `${site.kind}/${site.slug}`,
        address: site.address,
      } satisfies PersonalSiteDeepLink,
    },
  }));
}

const { site, deepLink } = Astro.props as { site: PersonalSite; deepLink: PersonalSiteDeepLink };
const documents = await getDesktopDocuments();
---

<DesktopPage documents={documents} site={site} deepLink={deepLink} />
