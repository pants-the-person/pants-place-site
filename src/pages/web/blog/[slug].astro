---
import WebLayout from '../../../layouts/WebLayout.astro';
import { render } from 'astro:content';
import { formatDate, getBlog } from '../../../lib/web';

export async function getStaticPaths() {
  const posts = await getBlog();
  return posts.map((entry) => ({
    params: { slug: entry.id.split('/').pop() ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<WebLayout title={`${entry.data.title} — The Pants Log`} description={entry.data.summary}>
  <article class="web-article">
    <h1>{entry.data.title}</h1>
    <p class="web-post-date">
      {formatDate(entry.data.date)} · by {entry.data.author}
    </p>
    <p><b>{entry.data.summary}</b></p>
    <Content />
    <hr />
    <p>
      <a href="/web/blog/">« Back to the Pants Log</a> ·
      <a href="/web/">Home</a>
    </p>
  </article>
</WebLayout>
