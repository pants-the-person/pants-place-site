          <tr><td>Board</td><td>generic Socket 3</td></tr>
          <tr><td>Video</td><td>S3 Trio64, 2 MB</td></tr>
          <tr><td>Sound</td><td>Sound Blaster 16</td></tr>
          <tr><td>Cooling</td><td>one fan, one dream</td></tr>
        </table>
      </div>
      <div class="web-panel">
        <h3>Guestbook</h3>
        <p>Tell me my benchmarks are wrong.</p>
        <p><a href="/web/guestbook/">📖 Sign my guestbook!</a></p>
      </div>
