---
import WebLayout from '../../../layouts/WebLayout.astro';
import { entryUrl, formatShortDate, getBlog, getNews } from '../../../lib/web';

const news = await getNews();
const blog = await getBlog();

const index = [
  { title: 'PantsNet Start Page', url: '/web/', text: 'browser help guide address bar favorites old net local webring start page' },
  { title: 'Pants News', url: '/web/news/', text: 'news archive updates overclocking y2k webring midi' },
  { title: 'The Pants Log', url: '/web/blog/', text: 'blog devlog computers web winamp geocities 486 midi' },
  { title: 'pants_the_person', url: '/sites/member/pants/', text: 'personal homepage 486 sound blaster doom midi overclocking' },
  { title: "Kylie's Cyber Sanctuary", url: '/sites/member/kylie/', text: 'kylie final fantasy vii gundam wing mobile suit rave techno warehouse flyer materia chocobo cat' },
  { title: 'UltimateShades Arcade', url: '/sites/member/shades/', text: 'gaming monkey island lucasarts scumm adventure games reviews grim fandango day of the tentacle high scores' },
  { title: "pip's kewl page", url: '/sites/member/pip/', text: 'pip pokemon anime pentium two guestbook first homepage' },
  { title: "Chogi's Nest", url: '/sites/char/chogi/', text: 'chogi cat chocobo treats naps guestbook keyboard' },
  { title: 'JIROJI.EXE', url: '/sites/char/jiroji/', text: 'jiroji virtual mascot patch notes save files modem songs' },
  { title: 'Guestbook', url: '/web/guestbook/', text: 'sign guestbook messages friends' },
  { title: 'The Old Net Webring', url: '/web/webring/', text: 'webring members previous next random retro sites' },
  { title: 'Downloads', url: '/web/downloads/', text: 'midi ogg wallpapers buttons downloads' },
  ...news.map((entry) => ({
    title: entry.data.title,
    url: entryUrl(entry),
    text: `${entry.data.summary} ${formatShortDate(entry.data.date)} news ${entry.body ?? ''}`,
  })),
  ...blog.map((entry) => ({
    title: entry.data.title,
    url: entryUrl(entry),
    text: `${entry.data.summary} ${formatShortDate(entry.data.date)} blog ${entry.body ?? ''}`,
  })),
];
---

<WebLayout title="AltaVista Search — PANTS PLACE 98" description="Search the World Wide Web.">
  <div style="text-align:center;margin-bottom:10px">
    <div style="font-family:Impact;font-size:36px;color:#0000ff;letter-spacing:1px">AltaVista</div>
    <div style="font-family:'Courier New',monospace;font-size:12px;color:#555">The most powerful and useful guide to the World Wide Web.</div>
  </div>

  <form class="web-search" action="/web/search/" method="get">
    <input name="q" placeholder="Search the web..." autofocus />
    <button type="submit">Search</button>
  </form>

  <div id="search-summary"></div>
  <ul class="web-results" id="search-results"></ul>

  <div id="oldnet-search" style="display:none">
    <h2>The Old Net Archive</h2>
    <div id="oldnet-summary"></div>
    <ul class="web-results" id="oldnet-results"></ul>
  </div>

  <div id="search-tips">
    <h2>Popular Searches</h2>
    <ul>
      <li><a href="/web/search/?q=486">486</a></li>
      <li><a href="/web/search/?q=midi">MIDI</a></li>
      <li><a href="/web/search/?q=winamp">Winamp</a></li>
      <li><a href="/web/search/?q=geocities">GeoCities</a></li>
      <li><a href="/web/search/?q=webring">Webring</a></li>
    </ul>
  </div>

  <script type="application/json" id="search-index" set:html={JSON.stringify(index)} />
  <script is:inline>
    (() => {
      const data = JSON.parse(document.getElementById('search-index').textContent || '[]');
      const params = new URLSearchParams(location.search);
      const query = (params.get('q') || '').trim().toLowerCase();
      const results = document.getElementById('search-results');
      const summary = document.getElementById('search-summary');
      const tips = document.getElementById('search-tips');
      const oldnetSection = document.getElementById('oldnet-search');
      const oldnetResults = document.getElementById('oldnet-results');
      const oldnetSummary = document.getElementById('oldnet-summary');
      const OLDNET_API = '/api/oldnet/v2';

      function appendResult(list, item) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.title;
        if (item.oldnetUrl) {
          link.dataset.oldnetUrl = item.oldnetUrl;
          link.dataset.oldnetYear = String(item.year || 1998);
        }
        const desc = document.createElement('div');
        desc.style.fontSize = '13px';
        desc.style.color = '#333';
        desc.textContent = item.description || '';
        li.append(link, desc);
        list.appendChild(li);
      }

      async function fetchOldNetSearch(term) {
        // Prefer the cached same-origin API. In `astro dev` (or if the API is
        // down) fall back to The Old Net's CORS-enabled endpoint.
        const urls = [
          OLDNET_API + '/find?' + new URLSearchParams({ query: term }).toString(),
          'https://theoldnet.com/find?query=' + encodeURIComponent(term),
        ];
        let lastError;
        for (let index = 0; index < urls.length; index++) {
          const controller = new AbortController();
          const timer = setTimeout(() => controller.abort(), 20000);
          try {
            const response = await fetch(urls[index], {
              ...(index === 1 ? { mode: 'cors' } : {}),
              signal: controller.signal,
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            return await response.text();
          } catch (error) {
            lastError = error;
          } finally {
            clearTimeout(timer);
          }
        }
        throw lastError;
      }

      async function searchOldNet(term) {
        oldnetSection.style.display = 'block';
        oldnetResults.replaceChildren();
        oldnetSummary.textContent = 'Contacting The Old Net...';
        try {
          const html = await fetchOldNetSearch(term);
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const seen = new Set();
          const entries = [];
          for (const anchor of doc.querySelectorAll('a[href*="/get?url="]')) {
            const bold = anchor.querySelector('b');
            if (!bold) continue;
            const href = anchor.getAttribute('href');
            if (!href) continue;
            const parsed = new URL(href, 'https://theoldnet.com/');
            let original = parsed.searchParams.get('url');
            if (!original) continue;
            if (!/^https?:\/\//i.test(original)) original = 'http://' + original;
            const key = original.toLowerCase();
            if (seen.has(key)) continue;
            seen.add(key);
            entries.push({ title: bold.textContent.trim() || original, original });
          }
          oldnetSummary.textContent = entries.length
            ? `Found ${entries.length} archived page(s). Showing the first ${Math.min(entries.length, 20)}.`
            : 'No archived pages matched that query.';
          for (const entry of entries.slice(0, 20)) {
            appendResult(oldnetResults, {
              title: entry.title,
              url: OLDNET_API + '/get?' + new URLSearchParams({ url: entry.original, year: '1998' }).toString(),
              oldnetUrl: entry.original,
              year: 1998,
              description: entry.original,
            });
          }
        } catch {
          oldnetSummary.textContent = 'The Old Net did not answer. Internal results are still shown above.';
        }
      }

      if (!query) {
        summary.textContent = 'Enter a search term above. Try 486, MIDI, or Winamp.';
        return;
      }

      const matches = data.filter((item) => {
        const haystack = (item.title + ' ' + item.text).toLowerCase();
        return query.split(/\s+/).every((word) => haystack.includes(word));
      });

      tips.style.display = 'none';
      summary.textContent = `Found ${matches.length} local result(s) for "${query}".`;
      results.replaceChildren();

      if (!matches.length) {
        const li = document.createElement('li');
        li.textContent = 'No local documents matched your query.';
        results.appendChild(li);
      } else {
        for (const item of matches) {
          appendResult(results, {
            title: item.title,
            url: item.url,
            description: item.text.replace(/\s+/g, ' ').slice(0, 180),
          });
        }
      }

      void searchOldNet(query);
    })();
  </script>
</WebLayout>
