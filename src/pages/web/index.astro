---
import WebLayout from '../../layouts/WebLayout.astro';
import ringData from '../../data/oldnet-webring.json';
import { personalSites } from '../../kernel/sites';

const oldnetMembers = ringData.members;
---

<WebLayout
  title="PantsNet Start Page — PANTS PLACE 98"
  description="How to use the PantsNet browser, plus the local site webring and The Old Net Webring."
>
  <div style="text-align:center">
    <h1>WELCOME TO PANTSNET</h1>
    <p style="font-family:'Courier New',monospace;font-size:13px">
      ~ your guide to the World Wide Web, 1998 edition ~
    </p>
  </div>

  <div class="web-columns">
    <div>
      <h2>HOW TO USE THIS BROWSER</h2>
      <div class="web-panel">
        <ol class="pantsnet-steps">
          <li>
            <b>Type an address.</b> Use the Address bar and press Enter. Shortcuts like
            <code>news</code>, <code>blog</code>, <code>pants</code>, <code>kylie</code> and
            <code>chogi</code> work too.
          </li>
          <li>
            <b>Move around.</b> Use <b>Back</b>, <b>Forward</b>, <b>Refresh</b> and <b>Home</b>
            in the toolbar. The address bar and status bar update as you browse.
          </li>
          <li>
            <b>Keep your places.</b> Use <b>Favorites</b> and <b>History</b> to jump back to a page.
            Add the current page with <b>Favorites → Add to Favorites</b>.
          </li>
          <li>
            <b>Browse the Old Web.</b> Pick a year in the <b>Old Net</b> selector, then enter a
            real address such as <code>www.winamp.com</code>. Archived sites open through The Old Net.
          </li>
          <li>
            <b>Open a site from outside.</b> Visiting <code>pants.place/member/pants</code> in the
            real browser boots this desktop and opens this window at the site. Nested pages and the
            old <code>/users/pants</code> address work too.
          </li>
        </ol>
      </div>

      <div class="web-panel web-panel-hot">
        <h3>TRY THESE ADDRESSES</h3>
        <p style="margin-top:0">
          Type any of these into the Address bar. They are all part of the fake web.
        </p>
        <ul style="margin-bottom:0">
          <li><a href="/web/news/">news</a> — updates from pants_the_person</li>
          <li><a href="/web/blog/">blog</a> — the Pants Log</li>
          <li><a href="/web/guestbook/">guestbook</a> — sign it, please</li>
          <li><a href="/web/downloads/">downloads</a> — MIDI files and buttons</li>
          <li><a href="/web/search/">search</a> — AltaVista-style web search</li>
          <li><a href="/web/webring/">webring</a> — The Old Net Webring</li>
        </ul>
      </div>

      <h2 id="local-webring">THE LOCAL WEBRING</h2>
      <div class="web-panel">
        <p>
          A webring is a circle of websites. This one is the local ring: six sites that live
          right here inside PantsNet. Visit one, then use its own links to find the others.
        </p>
        <p style="text-align:center">
          <button type="button" id="local-ring-random" class="pantsnet-random">
            🎲 RANDOM LOCAL SITE
          </button>
        </p>
        <ul class="pantsnet-ring">
          {personalSites.map((site) => (
            <li>
              <div class="pantsnet-ring-title">
                <span class="pantsnet-ring-kind">{site.kind === 'member' ? 'MEMBER' : 'CHARACTER'}</span>{' '}
                <a href={site.contentPath} data-local-ring>{site.title}</a>
              </div>
              <div class="pantsnet-ring-description">{site.description}</div>
              <div class="pantsnet-ring-address">{site.address}</div>
            </li>
          ))}
        </ul>
      </div>

      <h2 id="oldnet-webring">THE OLD NET WEBRING</h2>
      <div class="web-panel">
        <p>
          Below the local ring is the bigger ring: {oldnetMembers.length} retro sites, personal
          homepages and small web projects mirrored from The Old Net. These open through the
          archive, so expect a few missing images and a lot of animated GIFs.
        </p>
        <p style="text-align:center;margin-bottom:0">
          <a href="/web/webring/"><b>Browse The Old Net Webring »</b></a>
        </p>
      </div>
    </div>

    <aside>
      <div class="web-panel">
        <h3>Quick Addresses</h3>
        <ul style="margin-left:16px">
          {personalSites.map((site) => (
            <li>
              <a href={site.contentPath}>{site.displayName}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="web-panel">
        <h3>Personal Sites</h3>
        <p style="font-size:14px">
          Public desktop links (the browser loads the site inside this window):
        </p>
        <p style="font-family:'Courier New',monospace;font-size:12px;line-height:1.5">
          pants.place/member/pants<br />
          pants.place/members/pants<br />
          pants.place/users/pants<br />
          pants.place/char/chogi
        </p>
        <p style="font-size:13px;margin-bottom:0">
          Add <code>?autostart=winamp.exe</code> to open an app too.
        </p>
      </div>

      <div class="web-panel" style="text-align:center;background:#000;">
        <div style="color:#00ff00;font-family:'Courier New',monospace;font-size:13px;">BEST VIEWED IN</div>
        <div style="color:#ffff00;font-family:Impact;font-size:22px;letter-spacing:1px;">800x600</div>
        <div style="color:#00ffff;font-family:'Courier New',monospace;font-size:12px;">16-BIT COLOR</div>
      </div>
    </aside>
  </div>

  <script is:inline>
    (() => {
      const button = document.getElementById('local-ring-random');
      if (!button) return;
      button.addEventListener('click', () => {
        const links = Array.from(document.querySelectorAll('a[data-local-ring]'));
        if (!links.length) return;
        const link = links[Math.floor(Math.random() * links.length)];
        if (link instanceof HTMLAnchorElement) location.href = link.href;
      });
    })();
  </script>
</WebLayout>
